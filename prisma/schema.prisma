// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Changed to sqlite for local development/portability. Switch to postgresql for production.
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Job {
  id          String   @id @default(uuid())
  pickup      String
  destination String
  date        DateTime
  houseType   String
  notes       String?
  phone       String
  status      String   @default("New") // New, Scheduled, In Progress, Completed
  
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  
  staff       Staff[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Staff {
  id        String   @id @default(uuid())
  name      String
  role      String   @default("Mover")
  status    String   @default("Available") // Available, on Job
  jobs      Job[]
}

model Vehicle {
  id        String   @id @default(uuid())
  type      String   // Truck, Van
  plate     String   @unique
  status    String   @default("Available") // Available, In Use, Maintenance
  jobs      Job[]
}
